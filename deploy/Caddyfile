# LEGACY — prefer deploy/caddy.edge.Caddyfile (TLS edge) + deploy/nginx.origin.conf.
#
# This file had Caddy terminate TLS *and* serve static files / PHP directly.
# Current architecture: Caddy → reverse_proxy → Nginx on 127.0.0.1:8080.
# See docs/hosting/caddy-nginx.md

{
	email admin@example.com

	on_demand_tls {
		ask http://127.0.0.1:8080/caddy/allowed
	}
}

app.example.com {
	encode zstd gzip

	root * /var/www/builder/public
	php_fastcgi unix//run/php/php8.4-fpm.sock
	file_server
}

http://127.0.0.1:8080 {
	reverse_proxy unix//run/php/php8.4-fpm.sock {
		transport fastcgi {
			root /var/www/builder/public
			split .php
		}
	}
}

https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	@subdomain host_regexp sub ^([a-z0-9-]+)\.sites\.example\.com$
	handle @subdomain {
		root * /srv/websites/{re.sub.1}
		file_server
	}

	handle {
		root * /srv/websites/domains/{host}
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
