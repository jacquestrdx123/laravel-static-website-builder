# SiteForge deployment configuration.
#
# Copy to deploy/deploy.env on the server (/var/www/builder/shared/deploy.env)
# and fill in. Never commit the filled-in copy — it is gitignored.
#
#   cp deploy/deploy.env.example deploy/deploy.env

# --- Hostnames -------------------------------------------------------------
# Builder application host. Needs an A record -> this server.
APP_HOST=app.example.com

# Wildcard zone for free customer sites: {slug}.SITES_DOMAIN
# Needs an A record for SITES_DOMAIN *and* a wildcard A for *.SITES_DOMAIN.
SITES_DOMAIN=sites.example.com

# Let's Encrypt / ZeroSSL registration address for Caddy.
ACME_EMAIL=admin@example.com

# --- Source ----------------------------------------------------------------
REPO_URL=git@github.com:jacquestrdx123/laravel-static-website-builder.git
REPO_BRANCH=main

# --- Layout ----------------------------------------------------------------
DEPLOY_USER=forge
APP_BASE=/var/www/builder
SITES_ROOT=/srv/websites
PHP_VERSION=8.4

# How many old releases to retain for rollback.
KEEP_RELEASES=5

# --- Database --------------------------------------------------------------
DB_DATABASE=siteforge
DB_USERNAME=siteforge
# Leave blank on first provision — a strong password is generated and written
# into shared/.env and back into this file.
DB_PASSWORD=
